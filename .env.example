# Supabase Configuration
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenRouter Configuration (Barnabas AI & Daily Devotionals)
EXPO_PUBLIC_OPENROUTER_API_KEY=your-openrouter-key-here
EXPO_PUBLIC_OPENROUTER_MODEL=openrouter/auto

# RevenueCat Configuration (Phase 5 Subscriptions)
# Retrieve from RevenueCat Dashboard -> Project Settings -> API Keys (Public app-specific key)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_revenuecat_apple_key_here
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_revenuecat_google_key_here

